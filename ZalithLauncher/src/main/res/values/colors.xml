<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    tools:ignore="ContentDescription">

    <!-- BACKGROUND IMAGE -->
    <ImageView
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- TOP BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:background="@color/background_menu_top"
        app:layout_constraintTop_toTopOf="parent">

        <com.movtery.zalithlauncher.ui.view.AnimTextView
            android:id="@+id/app_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:textColor="@color/menu_bar_text"
            android:textSize="@dimen/_20ssp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/download_button"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download"
            android:tint="@color/menu_bar_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/setting_button"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_settings"
            android:tint="@color/menu_bar_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DIVIDER -->
    <View
        android:id="@+id/shadowView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/background_menu_element"
        app:layout_constraintTop_toBottomOf="@id/top_layout" />

    <!-- MAIN CONTENT AREA -->
    <ScrollView
        android:id="@+id/main_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/shadowView"
        app:layout_constraintBottom_toTopOf="@id/progress_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO CARD - Welcome Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/hero_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_16sdp"
                app:cardBackgroundColor="@color/background_menu_element"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="@dimen/_4sdp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_20sdp">

                    <TextView
                        android:id="@+id/hero_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Welcome back!"
                        android:textSize="@dimen/_28ssp"
                        android:textStyle="bold"
                        android:textColor="@color/menu_bar_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/hero_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ready to launch?"
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/menu_progress"
                        android:layout_marginTop="@dimen/_6sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/hero_title" />

                    <com.movtery.zalithlauncher.ui.view.AnimButton
                        android:id="@+id/play_button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_52sdp"
                        android:text="▶ PLAY NOW"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:background="@drawable/background_card"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/hero_subtitle"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- QUICK ACTIONS SECTION -->
            <TextView
                android:id="@+id/section_label_quick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="Quick Actions"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                android:textColor="@color/menu_progress" />

            <!-- ACTION BUTTONS GRID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="@dimen/_16sdp"
                android:spacing="@dimen/_10sdp">

                <com.movtery.zalithlauncher.ui.view.AnimButton
                    android:id="@+id/btn_mods"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_weight="1"
                    android:text="Mods"
                    android:textSize="@dimen/_12ssp"
                    android:background="@drawable/background_card" />

                <com.movtery.zalithlauncher.ui.view.AnimButton
                    android:id="@+id/btn_worlds"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_weight="1"
                    android:text="Worlds"
                    android:textSize="@dimen/_12ssp"
                    android:background="@drawable/background_card" />

                <com.movtery.zalithlauncher.ui.view.AnimButton
                    android:id="@+id/btn_downloads"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_weight="1"
                    android:text="Downloads"
                    android:textSize="@dimen/_12ssp"
                    android:background="@drawable/background_card" />

            </LinearLayout>

            <!-- DYNAMIC FRAGMENT CONTAINER -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/container_fragment"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_400sdp"
                android:layout_margin="@dimen/_16sdp" />

        </LinearLayout>

    </ScrollView>

    <!-- PROGRESS/LOADING SECTION -->
    <View
        android:id="@+id/progress_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/background_menu_element"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- NOTICE DIALOG (HIDDEN BY DEFAULT) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/notice_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/_12sdp"
        android:background="@drawable/background_card"
        android:padding="@dimen/_16sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/notice_guideline"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_layout"
        app:layout_constraintVertical_bias="0.333">

        <TextView
            android:id="@+id/notice_title_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="@dimen/_18ssp"
            android:textColor="@color/menu_bar_text"
            android:gravity="center_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginVertical="@dimen/_12sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/notice_title_view"
            app:layout_constraintBottom_toTopOf="@id/notice_got_button">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notice_message_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/primary_text"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/notice_date_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="end"
                    android:textColor="@color/menu_progress" />

            </LinearLayout>

        </ScrollView>

        <com.movtery.zalithlauncher.ui.view.AnimButton
            android:id="@+id/notice_got_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/generic_ok"
            android:layout_marginTop="@dimen/_12sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/notice_message_view"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/notice_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.35" />

    <!-- DECORATIVE OVERLAY (HIDDEN BY DEFAULT) -->
    <ImageView
        android:id="@+id/hair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_hair" />

</androidx.constraintlayout.widget.ConstraintLayout>
