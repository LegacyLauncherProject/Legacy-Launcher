<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:ignore="ContentDescription">

    <!-- BACKGROUND IMAGE/GRADIENT -->
    <ImageView
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- TOP BAR - Sleek header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:background="@color/background_menu_top"
        app:layout_constraintTop_toTopOf="parent">

        <com.movtery.zalithlauncher.ui.view.AnimTextView
            android:id="@+id/app_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:textColor="@color/menu_bar_text"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold"
            android:text="Legacy"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/download_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download"
            android:tint="#FFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/setting_button"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_settings"
            android:tint="#FFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SHADOW UNDER TOP BAR -->
    <View
        android:id="@+id/shadowView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_6sdp"
        android:background="@drawable/shadow_gradient_down"
        app:layout_constraintTop_toBottomOf="@id/top_layout" />

    <!-- MAIN CONTENT SCROLLABLE AREA -->
    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/shadowView"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_16sdp">

            <!-- WELCOME BACK CARD - Main hero section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/welcome_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_12sdp"
                android:background="@drawable/background_card"
                android:padding="@dimen/_16sdp"
                android:minHeight="@dimen/_120sdp">

                <TextView
                    android:id="@+id/welcome_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Welcome back!"
                    android:textSize="@dimen/_24ssp"
                    android:textStyle="bold"
                    android:textColor="@color/black_or_white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/welcome_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Ready to play your favorite worlds?"
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="@dimen/_4sdp"
                    app:layout_constraintTop_toBottomOf="@id/welcome_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- PLAY BUTTON - BIG AND BOLD -->
                <com.movtery.zalithlauncher.ui.view.AnimButton
                    android:id="@+id/quick_play_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="▶ PLAY"
                    android:textSize="@dimen/_16ssp"
                    android:textStyle="bold"
                    android:background="@drawable/button_play_primary"
                    android:textColor="@color/white"
                    app:layout_constraintTop_toBottomOf="@id/welcome_subtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- QUICK ACCESS SECTION -->
            <TextView
                android:id="@+id/quick_access_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="Quick Access"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                android:textColor="@color/black_or_white" />

            <!-- HORIZONTAL BUTTONS GRID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="@dimen/_12sdp"
                android:gravity="center"
                android:spacing="@dimen/_8sdp">

                <com.movtery.zalithlauncher.ui.view.AnimButton
                    android:id="@+id/manage_mods_btn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_44sdp"
                    android:layout_weight="1"
                    android:text="Mods"
                    android:textSize="@dimen/_12ssp"
                    android:background="@drawable/button_secondary" />

                <com.movtery.zalithlauncher.ui.view.AnimButton
                    android:id="@+id/manage_worlds_btn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_44sdp"
                    android:layout_weight="1"
                    android:text="Worlds"
                    android:textSize="@dimen/_12ssp"
                    android:background="@drawable/button_secondary" />

                <com.movtery.zalithlauncher.ui.view.AnimButton
                    android:id="@+id/downloads_btn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_44sdp"
                    android:layout_weight="1"
                    android:text="Downloads"
                    android:textSize="@dimen/_12ssp"
                    android:background="@drawable/button_secondary" />

            </LinearLayout>

            <!-- FRAGMENT CONTAINER FOR DYNAMIC CONTENT -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/container_fragment"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_300sdp"
                android:layout_margin="@dimen/_12sdp" />

            <!-- NOTICE LAYOUT - Popup card (hidden by default) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/notice_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_12sdp"
                android:background="@drawable/background_card"
                android:padding="@dimen/_12sdp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/notice_title_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="@dimen/_16ssp"
                    android:textColor="@color/black_or_white"
                    android:gravity="center_horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/notice_message_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/text_secondary"
                    android:textIsSelectable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/notice_title_view" />

                <TextView
                    android:id="@+id/notice_date_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/notice_message_view" />

                <com.movtery.zalithlauncher.ui.view.AnimButton
                    android:id="@+id/notice_got_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="OK"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/notice_date_view"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </ScrollView>

    <!-- PROGRESS/LOADING LAYOUT -->
    <View
        android:id="@+id/progress_shadowView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_4sdp"
        android:background="@drawable/shadow_gradient_up"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_layout" />

    <!-- BOTTOM NAVIGATION BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_nav_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_60sdp"
        android:background="@color/background_menu_bottom"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- SHADOW ABOVE NAV -->
        <View
            android:id="@+id/nav_shadow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_4sdp"
            android:background="@drawable/shadow_gradient_up"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- NAV ICONS -->
        <ImageButton
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="?attr/selectableItemBackground"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home"
            android:tint="@color/menu_bar_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nav_shadow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/nav_mods" />

        <ImageButton
            android:id="@+id/nav_mods"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="?attr/selectableItemBackground"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download"
            android:tint="@color/menu_bar_text"
            app:layout_constraintStart_toEndOf="@id/nav_home"
            app:layout_constraintTop_toBottomOf="@id/nav_shadow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/nav_center" />

        <ImageButton
            android:id="@+id/nav_center"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="?attr/selectableItemBackground"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_settings"
            android:tint="@color/menu_bar_text"
            app:layout_constraintStart_toEndOf="@id/nav_mods"
            app:layout_constraintTop_toBottomOf="@id/nav_shadow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/nav_worlds" />

        <ImageButton
            android:id="@+id/nav_worlds"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="?attr/selectableItemBackground"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download"
            android:tint="@color/menu_bar_text"
            app:layout_constraintStart_toEndOf="@id/nav_center"
            app:layout_constraintTop_toBottomOf="@id/nav_shadow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/nav_profile" />

        <ImageButton
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="?attr/selectableItemBackground"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_settings"
            android:tint="@color/menu_bar_text"
            app:layout_constraintStart_toEndOf="@id/nav_worlds"
            app:layout_constraintTop_toBottomOf="@id/nav_shadow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DECORATIVE HAIR/OVERLAY (HIDDEN BY DEFAULT) -->
    <ImageView
        android:id="@+id/hair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_hair" />

</androidx.constraintlayout.widget.ConstraintLayout>
